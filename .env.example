# ============================================
# VAREXO KLANTPORTAAL - ENVIRONMENT VARIABLES
# ============================================

# NeonSQL Database (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://varexo_owner:password@ep-xxxx.eu-central-1.aws.neon.tech/varexo?sslmode=require

# Mollie Payments (LIVE key van je dashboard)
MOLLIE_API_KEY=live_xxxxxxxxxxxx

# JWT Secret (maak zelf een lange random string)
JWT_SECRET=your_super_secret_key_here_min_32_chars

# Webhook URL (voor Mollie callbacks)
WEBHOOK_URL=https://varexo.nl/api/webhooks/mollie

# Frontend URL (voor redirects)
FRONTEND_URL=https://varexo.nl

# Server port (voor local development)
PORT=3001
